{
  "name": "hsi-core-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": "1.x"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "bun run check:coverage && bun run check:evidence && bun run check:api && bun run check:validation && vite build",
    "check:api": "tsc --noEmit -p api/tsconfig.json",
    "preview": "vite preview",
    "check:evidence": "bun ../scripts/build-evidence-corpus.ts --check",
    "check:coverage": "bun --no-env-file ../scripts/build-research-coverage.ts --check",
    "check:validation": "bun --no-env-file ../scripts/build-synthetic-validation.ts --check"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
