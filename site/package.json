{
  "name": "hsi-core-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": "1.x"
  },
  "scripts": {
    "test:e2e": "playwright test",
    "dev": "vite",
    "build": "bun run check:coverage && bun run check:evidence && bun run check:api && bun run check:validation && bun run check:graph && bun run check:domain-graph && vite build && vite build --ssr scripts/prerender-entry.tsx --outDir .seo-render && bun --no-env-file scripts/build-seo.ts && bun --no-env-file scripts/check-public-names.ts && bun --no-env-file scripts/check-bundle-budget.ts",
    "check:api": "tsc --noEmit -p api/tsconfig.json",
    "preview": "vite preview",
    "check:evidence": "bun ../scripts/build-evidence-corpus.ts --check",
    "check:coverage": "bun --no-env-file ../scripts/build-research-coverage.ts --check",
    "check:validation": "bun --no-env-file ../scripts/build-synthetic-validation.ts --check",
    "qa:accessibility": "playwright test production-qa.spec.ts",
    "qa:lighthouse": "node scripts/qa/lighthouse.mjs",
    "check:graph": "bun --no-env-file ../scripts/build-claim-graph.ts --check",
    "check:domain-graph": "bun --no-env-file ../scripts/build-domain-graph.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/host-grotesk": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "chrome-launcher": "1.2.3",
    "lighthouse": "13.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
