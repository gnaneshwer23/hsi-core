Name":"Emery P","lastName":"Emery","firstName":"P","initials":"P"},{"fullName":"Morgan A","lastName":"Morgan","firstName":"A","initials":"A"},{"fullName":"Birrell F","lastName":"Birrell","firstName":"F","initials":"F","authorId":{"type":"ORCID","value":"0000-0002-6163-6155"}},{"fullName":"Crook P","lastName":"Crook","firstName":"P","initials":"P"},{"fullName":"Foster HE","lastName":"Foster","firstName":"H E","initials":"HE"},{"fullName":"Griffiths B","lastName":"Griffiths","firstName":"B","initials":"B"},{"fullName":"Griffiths ID","lastName":"Griffiths","firstName":"I D","initials":"ID"},{"fullName":"Grove ML","lastName":"Grove","firstName":"M L","initials":"ML"},{"fullName":"Isaacs JD","lastName":"Isaacs","firstName":"J D","initials":"JD"},{"fullName":"Kay L","lastName":"Kay","firstName":"L","initials":"L"},{"fullName":"Myers A","lastName":"Myers","firstName":"A","initials":"A"},{"fullName":"Platt PN","lastName":"Platt","firstName":"P N","initials":"PN"},{"fullName":"Walker DJ","lastName":"Walker","firstName":"D J","initials":"DJ"},{"fullName":"Bowman","lastName":"Bowman"},{"fullName":"Jobanputra P","lastName":"Jobanputra","firstName":"P","initials":"P"},{"fullName":"Jubb RW","lastName":"Jubb","firstName":"R W","initials":"RW"},{"fullName":"Rankin EC","lastName":"Rankin","firstName":"E C","initials":"EC"},{"fullName":"Carpenter EH","lastName":"Carpenter","firstName":"E H","initials":"EH"},{"fullName":"Dawes PT","lastName":"Dawes","firstName":"P T","initials":"PT"},{"fullName":"Hassell A","lastName":"Hassell","firstName":"A","initials":"A"},{"fullName":"Hay EM","lastName":"Hay","firstName":"E M","initials":"EM"},{"fullName":"Kamath S","lastName":"Kamath","firstName":"S","initials":"S"},{"fullName":"Packham J","lastName":"Packham","firstName":"J","initials":"J","authorId":{"type":"ORCID","value":"0000-0001-5531-1680"}},{"fullName":"Shadforth MF","lastName":"Shadforth","firstName":"M F","initials":"MF"},{"fullName":"Donnelly SP","lastName":"Donnelly","firstName":"S P","initials":"SP"},{"fullName":"Doyle D","lastName":"Doyle","firstName":"D","initials":"D"},{"fullName":"Hakim A","lastName":"Hakim","firstName":"A","initials":"A"},{"fullName":"Lanham JG","lastName":"Lanham","firstName":"J G","initials":"JG"}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0001-5531-1680"},{"type":"ORCID","value":"0000-0001-8242-9262"},{"type":"ORCID","value":"0000-0002-2391-5575"},{"type":"ORCID","value":"0000-0002-6103-7056"},{"type":"ORCID","value":"0000-0002-6163-6155"},{"type":"ORCID","value":"0000-0002-7863-9176"},{"type":"ORCID","value":"0000-0002-8625-1200"},{"type":"ORCID","value":"0000-0002-9022-5179"},{"type":"ORCID","value":"0000-0003-0544-042X"},{"type":"ORCID","value":"0000-0003-1109-624X"},{"type":"ORCID","value":"0000-0003-1570-1232"},{"type":"ORCID","value":"0000-0003-3316-2527"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics"]},"journalInfo":{"issue":"1","volume":"68","journalIssueId":1585981,"dateOfPublication":"2009 Jan","monthOfPublication":1,"yearOfPublication":2009,"journal":{"medlineAbbreviation":"Ann Rheum Dis","title":"Annals of the rheumatic diseases","essn":"1468-2060","issn":"0003-4967","nlmid":"0372355","isoabbreviation":"Ann Rheum Dis"},"printPublicationDate":"2009-01-01"},"pubYear":"2009","pageInfo":"69-74","abstractText":"<h4>Objective</h4>To determine whether rheumatoid factor (RF), anti-cyclic citrullinated peptide (CCP) antibodies, or carriage of shared epitope (SE) and PTPN22 genetic susceptibility variants predict response to therapy in patients with rheumatoid arthritis (RA) treated with anti-tumour necrosis factor (TNF) agents.<h4>Methods</h4>UK-wide multicentre collaborations were established to recruit a large cohort of patients treated with anti-TNF drugs for RA. Serum RF, anti-CCP antibody and SE status were determined using commercially available kits. PTPN22 R620W genotyping was performed by Sequenom MassArray. Linear regression analyses were performed to investigate the role of these four factors in predicting response to treatment by 6 months, defined as the absolute change in 28-joint Disease Activity Score (DAS28).<h4>Results</h4>Of the 642 patients analysed, 46% received infliximab, 43% etanercept and 11% adalimumab. In all, 89% and 82% of patients were RF and anti-CCP positive, respectively. Patients that were RF negative had a 0.48 (95% CI 0.08 to 0.87) greater mean improvement in DAS28 compared to patients that were RF positive. A better response was also seen among patients that were anti-CCP negative. No association was demonstrated between drug response and SE or PTPN22 620W carriage.<h4>Conclusion</h4>The presence of RF or anti-CCP antibodies was associated with a reduced response to anti-TNF drugs. However, these antibodies only account for a small proportion of the variance in treatment response. It is likely that genetic factors will contribute to treatment response, but these do not include the well established RA susceptibility loci, SE and PTPN22.","affiliation":"Arthritis Research Campaign Epidemiology Unit, University of Manchester, Manchester, UK.","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["research-article","Multicenter Study","Journal Article"]},"grantsList":{"grant":[{"agency":"Arthritis UK","acronym":"VAC_","grantId":"18475","orderIn":0},{"agency":"Versus Arthritis","acronym":"ARC_","grantId":"17552","orderIn":0},{"agency":"Medical Research Council","acronym":"MRC_","grantId":"G9818340B","orderIn":0},{"agency":"National Institute for Health Research (NIHR)","grantId":"NF-SI-0508-10299","orderIn":0}]},"meshHeadingList":{"meshHeading":[{"majorTopic_YN":"N","descriptorName":"Humans"},{"majorTopic_YN":"N","descriptorName":"Arthritis, Rheumatoid","meshQualifierList":{"meshQualifier":[{"majorTopic_YN":"Y","abbreviation":"BL","qualifierName":"blood"},{"majorTopic_YN":"N","abbreviation":"DT","qualifierName":"drug therapy"},{"majorTopic_YN":"Y","abbreviation":"GE","qualifi