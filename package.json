    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "site:preview": "bun run --cwd site preview",
    "research:api": "bun src/server/runInterrogativeApi.ts",
    "investigation:demo": "bun src/cli/investigation-demo.ts",
    "ra:import": "python3 tools/import_ra_evidence.py",
    "ra:test-parser": "python3 -m unittest discover -s test/python -v",
    "ra:export-artifact": "bun scripts/export-ra-evidence-artifact.ts",
    "ra:export-research-artifact": "bun scripts/export-ra-research-artifact.ts",
    "ra:verify-research-path": "bun scripts/verify-ra-research-path.ts",
