    "evidence:build": "bun scripts/build-evidence-corpus.ts",
    "evidence:check": "bun scripts/build-evidence-corpus.ts --check",
    "evaluation:scientific": "bun --no-env-file scripts/evaluate-scientific-assistance.ts",
    "consumers:prepare": "bun --no-env-file scripts/prepare-product-research-handoff.ts",
    "consumers:verify": "bun --no-env-file scripts/verify-product-research-acceptance.ts",
    "coverage:build": "bun --no-env-file scripts/build-research-coverage.ts",
