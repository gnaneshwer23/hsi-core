{
  "name": "hsi-core",
  "version": "0.1.0",
  "description": "Human Systems Intelligence shared evidence-grade edge/claim substrate for Aksh Health + Immune Super Intelligence",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared-technology": {
      "types": "./dist/sharedTechnology.d.ts",
      "import": "./dist/sharedTechnology.js"
    },
    "./research-contracts": {
      "types": "./dist/researchContracts.d.ts",
      "import": "./dist/researchContracts.js"
    },
    "./investigation-service": {
      "types": "./dist/investigationService.d.ts",
      "import": "./dist/investigationService.js"
    },
    "./investigation-backend": {
      "types": "./dist/investigationBackend.d.ts",
      "import": "./dist/investigationBackend.js"
    },
    "./ra-evidence-release": {
      "types": "./dist/raEvidenceRelease.d.ts",
      "import": "./dist/raEvidenceRelease.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sources:init": "bun src/cli/source-registry.ts init",
    "sources:import": "bun src/cli/source-registry.ts import",
    "test": "bun test ./test",
    "validate": "bun run src/cli/validate.ts",
    "export:isi": "bun run src/cli/export-isi.ts",
    "export:isi-map": "bun run src/cli/export-isi-map.ts",
    "export:aksh-map": "bun run src/cli/export-aksh-map.ts",
    "gap-report": "bun run src/cli/gap-report.ts",
    "curator-ux": "bun run src/cli/curator-ux.ts",
    "outputs": "bun run src/cli/publish.ts",
    "publish": "bun run outputs",
    "adapter:rdkit": "bun run src/cli/rdkit-adapter.ts",
    "adapter:openmm": "bun run src/cli/openmm-adapter.ts",
    "adapter:reinvent4": "bun run src/cli/reinvent4-adapter.ts",
    "adapter:esm": "bun run src/cli/esm-adapter.ts",
    "adapter:af3": "bun run src/cli/af3-adapter.ts",
    "adapter:tdc": "bun run src/cli/tdc-adapter.ts",
    "adapter:boltz": "bun run src/cli/boltz-adapter.ts",
    "adapter:isi-agents": "bun run src/cli/isi-agents-adapter.ts",
    "db:migrate": "bun run src/cli/migrate.ts",
    "db:gate-c-local": "bun run src/cli/gate-c-local.ts",
    "check": "bun run test && bun run validate && bun run outputs && bun run build",
    "site:dev": "bun run --cwd site dev",
    "site:build": "bun run --cwd site build",
    "site:preview": "bun run --cwd site preview",
    "investigation:demo": "bun src/cli/investigation-demo.ts",
    "ra:import": "python3 tools/import_ra_evidence.py",
    "ra:test-parser": "python3 -m unittest discover -s test/python -v",
    "ra:export-artifact": "bun scripts/export-ra-evidence-artifact.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
