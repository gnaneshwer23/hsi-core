# Optional HSI RDS staging (see docs/NEON_TO_AWS_RDS_RUNBOOK.md) — local .env.local only.
# Do NOT set Vercel/production DATABASE_URL to RDS until founder-approved cutover.
# neonGuard must allowlist the endpoint first (implementation phase); keep red-wave as rollback.
# DATABASE_URL=postgresql://HSI_APP:PASSWORD@hsi-staging.XXXX.eu-west-2.rds.amazonaws.com:5432/hsidb?sslmode=require
# HSI_DB_BACKEND=rds_staging
# HSI_RDS_HOST=hsi-staging.XXXX.eu-west-2.rds.amazonaws.com

# Apply schema (HSI red-wave only; refuses ISI/Akeno/DeliverX hosts):
#   cp .env.example .env.local   # fill USER/PASSWORD — never commit
#   bun run db:migrate
#   bun run db:gate-c-local
# Or without local secrets file:
#   bun run db:migrate -- --from-neonctl
# Vercel: store the same keys on the HSI project only, then `vercel env pull .env.local`

# Forbidden for HSI substrate (do not use):
