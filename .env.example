# Boltz weights policy (docs/P3_WEIGHTS_AND_LICENSE_POLICY.md):
# Research/dev ack that you will NOT vendor multi-GB Boltz weights into this repo.
# Required for `bun run adapter:boltz` stub proposals (Gate C pending only).
# WEIGHTS_POLICY_ACK=true
# Optional external weights cache path (local/CI only — never commit contents):
# BOLTZ_WEIGHTS_CACHE=$HOME/.cache/boltz-weights

# Public browser auth URL (Vite build-time configuration). Empty keeps sign-in disabled.
# Set the approved staging/provider HTTPS base URL in Vercel, then rebuild.
# Never put a database URL, token, API key or password in any VITE_* setting.
VITE_HSI_AUTH_BASE_URL=

# Trusted research API only (separate Bun process behind a same-origin HTTPS proxy).
# Use an explicitly confirmed HSI staging connection for testing. No DATABASE_URL fallback.
# These server variables never belong in a VITE_* setting or the frontend build.
HSI_DATABASE_URL=
HSI_NEON_PROJECT_ID=red-wave-06625195
HSI_PUBLIC_ORIGIN=
HSI_API_PORT=3100
# Start after configuring the trusted session/proxy integration:
#   bun run research:api
# See docs/ARCH-003-AUTHENTICATED-API-INTEGRATION.md.
