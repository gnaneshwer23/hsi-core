# HSI Neon only — never point this repo at ISI / immunecity / Akeno / DeliverX Neon.
# Copy to .env (gitignored). Do not commit real passwords.
#
# Tracked identifiers below are placeholders. Put real project, branch and host
# values only in this private file (never commit them):
#   HSI_NEON_CANONICAL_PROJECT_ID=
#   HSI_NEON_HOST_ALLOWLIST=ep-your-production,ep-your-staging
#   HSI_NEON_STAGING_BRANCH_PIN=
#   HSI_NEON_STAGING_HOST_PIN=
# See docs/NEON_PROJECT_MAP.md and docs/OWNER_DECISIONS.md

DATABASE_URL=postgresql://USER:PASSWORD@ep-hsi-production.REPLACE_REGION.aws.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=hsi-neon-project
NEON_BRANCH_ID=hsi-production-branch
NEON_DATABASE=neondb

# Optional HSI RDS staging (see docs/NEON_TO_AWS_RDS_RUNBOOK.md) — local .env.local only.
# Do NOT set Vercel/production DATABASE_URL to RDS until founder-approved cutover.
# neonGuard must allowlist the endpoint first (implementation phase); keep red-wave as rollback.
# DATABASE_URL=postgresql://HSI_APP:PASSWORD@hsi-staging.XXXX.eu-west-2.rds.amazonaws.com:5432/hsidb?sslmode=require
# HSI_DB_BACKEND=rds_staging
# HSI_RDS_HOST=hsi-staging.XXXX.eu-west-2.rds.amazonaws.com

# Apply schema (HSI red-wave only; refuses ISI/Akeno/DeliverX hosts):
#   cp .env.example .env.local   # fill USER/PASSWORD — never commit
#   bun run db:migrate
#   bun run db:gate-c-local
# Or without local secrets file:
#   bun run db:migrate -- --from-neonctl
# Vercel: store the same keys on the HSI project only, then `vercel env pull .env.local`

# Forbidden for HSI substrate (do not use):
#   isi-neon-project / ep-isi-product…  → ISI product Neon only
#   akeno-neon-project                   → Akeno (non-HSI; see akeno/.env.example AKENO_*)
#   deliverx-neon-project                     → DeliverX (ignore)
#
# Akeno HITL consumer in this repo (/akeno) does not need DATABASE_URL and
# must never point Gate C / migrations at silent-violet.

# Hypothetical test-fixture partner (src/hypotheticalPartnerFixture.ts):
# partnerSigned may be true under agreementKind=hypothetical_test_only for path testing.
# Production ISI / Discovery consumers MUST leave this unset/false unless intentionally
# exercising the fixture path. lockedPilot stays false until a real legalBinding partner.
# ALLOW_HYPOTHETICAL_PARTNER=true

# Boltz weights policy (docs/P3_WEIGHTS_AND_LICENSE_POLICY.md):
# Research/dev ack that you will NOT vendor multi-GB Boltz weights into this repo.
# Required for `bun run adapter:boltz` stub proposals (Gate C pending only).
# WEIGHTS_POLICY_ACK=true
# Optional external weights cache path (local/CI only — never commit contents):
# BOLTZ_WEIGHTS_CACHE=$HOME/.cache/boltz-weights

# Optional Google Search Console HTML-tag token (build-time only for site HTML).
# Prefer DNS TXT verification. Never invent a token; paste only the value GSC shows.
# GOOGLE_SITE_VERIFICATION=
# Optional IndexNow override (defaults to site/public/indexnow-key.txt). Bing/partners only.
# INDEXNOW_KEY=

# Public browser auth URL (Vite build-time configuration). Empty keeps sign-in disabled.
# Set the approved staging/provider HTTPS base URL in Vercel, then rebuild.
# Never put a database URL, token, API key or password in any VITE_* setting.
VITE_HSI_AUTH_BASE_URL=
# Enable only after /api/research/health confirms the Vercel server configuration.
# Rebuild and sign in again after changing this public routing flag.
VITE_HSI_USE_AUTH_GATEWAY=false

# Trusted research API only (Vercel Bun functions, or a separate proxied Bun process).
# Use an explicitly confirmed HSI staging connection for testing. No DATABASE_URL fallback.
# These server variables never belong in a VITE_* setting or the frontend build.
HSI_DATABASE_URL=
HSI_NEON_PROJECT_ID=hsi-neon-project
# Production canonical origin is https://www.humansuperintelligence.tech
# (apex humansuperintelligence.tech redirects to www). Do not set
# www.human-super-intelligence.co.uk — that hostname does not resolve.
HSI_PUBLIC_ORIGIN=
HSI_AUTH_BASE_URL=
# Vercel research writes default to disabled; never enable against production.
HSI_RESEARCH_WRITES_ENABLED=false
# Server-only binding to an existing, published, public-biomedical SSc release.
# Empty means no release is offered for new investigations. Never use a draft fixture
# or a release from a different disease/product; this setting does not publish it.
HSI_SSC_RESEARCH_RELEASE_ID=
# Optional independent, published HSI RA comparison release (not the working catalogue).
# Requires separately provisioned RA reviewer authority; never uses the ISI/Aksh DB.
HSI_RA_COMPARISON_RELEASE_ID=
# For an explicitly approved staging write test only:
# HSI_NEON_BRANCH_ID=hsi-staging-branch
HSI_API_PORT=3100
# Start after configuring the trusted session/proxy integration:
#   bun run research:api
# See docs/ARCH-003-AUTHENTICATED-API-INTEGRATION.md.
# Vercel setup (no separate server required): docs/VERCEL_RESEARCH_SETUP.md.

# Phase H server-only controls. No settings are changed automatically.
# Maintenance blocks protected research access; auth/sign-out remain separate.
HSI_RESEARCH_MAINTENANCE=false
# false still logs safe 5xx/admission events; true also logs successful requests.
HSI_OPERATIONAL_LOGGING=false
# Default process limits are NOT global/serverless abuse protection.
# Set true only after deploying a reviewed shared admission adapter/perimeter.
# Without that adapter, true fails closed with 503 (standalone: refuses startup).
HSI_PILOT_REQUIRE_SHARED_LIMITER=false

# Optional authenticated persistent coordinator; no endpoint/key is configured by default.
# Required for a multi-instance pilot; never use per-instance/serverless disk.
HSI_SHARED_ADMISSION_URL=
HSI_SHARED_ADMISSION_SERVICE_KEY=
